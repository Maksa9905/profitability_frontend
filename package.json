{
  "name": "profitability-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "openapi:types": "openapi-typescript openapi/auth.json -o app/shared/api/generated/auth.ts && openapi-typescript openapi/invest.json -o app/shared/api/generated/invest.ts",
    "openapi:docs": "node scripts/generate-api-docs-html.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@nuxt/ui": "^4.5.1",
    "@nuxtjs/i18n": "^10.2.4",
    "nuxt": "^4.4.2",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "4.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "happy-dom": "^20.8.9",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.5"
  },
  "packageManager": "pnpm@10.32.1"
}
