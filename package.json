{
  "name": "profitability-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "openapi:types": "openapi-typescript openapi/auth.json -o app/shared/api/generated/auth.ts && openapi-typescript openapi/invest.json -o app/shared/api/generated/invest.ts",
    "openapi:docs": "node scripts/generate-api-docs-html.mjs",
    "mock:api": "node mock/json-server/server.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@nuxt/ui": "^4.5.1",
    "@nuxtjs/i18n": "^10.2.4",
    "@unovis/ts": "^1.6.2",
    "axios": "^1.10.0",
    "nuxt": "^4.4.2",
    "nuxt-echarts": "^1.0.1",
    "tailwindcss": "^4.2.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@playwright/test": "^1.55.0",
    "@nuxt/test-utils": "4.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "json-server": "0.17.4",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.5"
  },
  "packageManager": "pnpm@10.32.1"
}
