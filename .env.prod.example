# Copy to .env.prod on VPS (never commit .env.prod).

IMAGE_REGISTRY=your-github-username
IMAGE_TAG=latest

FRONTEND_BIND_PORT=13030
NUXT_PUBLIC_SITE_URL=https://profit.hakolr.dev
NUXT_PUBLIC_API_BASE_URL=https://api.profit.hakolr.dev
NUXT_PUBLIC_DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001

# Runtime env_file is optional for frontend when API URL is baked in at CI build.
# First deploy: git pull && docker compose -f docker-compose.prod.yml --env-file .env.prod pull && up -d
